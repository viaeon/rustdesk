#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/remote/remote /usr/bin/remote
	
	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/remote.service ]; then
			rm /etc/systemd/system/remote.service /usr/lib/systemd/system/remote.service /usr/lib/systemd/user/remote.service >/dev/null  2>&1
		fi
		version=$(python3 -V 2>&1 | grep -Po '(?<=Python )(.+)')
		parsedVersion=$(echo "${version//./}")
        mkdir -p /usr/lib/systemd/system/
		cp /usr/share/remote/files/systemd/remote.service /usr/lib/systemd/system/remote.service
		# try fix error in Ubuntu 18.04
		# Failed to reload remote.service: Unit remote.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/remote.service:10: Executable path is not absolute: pkill -f "remote --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/remote.service
		fi
		systemctl daemon-reload
		systemctl enable rustdesk
		systemctl start rustdesk
	fi
fi
